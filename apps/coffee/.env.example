# Copy to .env.local and fill in. Never commit real values.

# Absolute site URL, enables canonical + hreflang once a domain exists.
SITE_URL=

# SumUp online payments (placeholder, see src/app/api/payments/sumup). Server-only.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Sister site (coiffeur subdomain), used for cross-links. Defaults to https://coiffeur3volution.ch/.
NEXT_PUBLIC_COIFFEUR_URL=
