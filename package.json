{
  "name": "3volution",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:coffee": "npm run dev -w @3volution/coffee",
    "dev:coiffeur": "npm run dev -w @3volution/coiffeur",
